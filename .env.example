BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Visual theme: school | madrasha | coaching
# The archived prototype folder is named "coacing", but the env value is "coaching".
SITE_THEME=school

# Optional comma-separated allowlist. When empty, any Google account can sign in.
ADMIN_EMAILS=
