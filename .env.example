BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=

# Admission enquiry delivery through Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=EduCanvas Admissions <admissions@your-verified-domain.example>
ADMISSION_ADMIN_EMAIL=

# Visual theme: school | madrasha | coaching
# The archived prototype folder is named "coacing", but the env value is "coaching".
SITE_THEME=school

# Optional comma-separated allowlist. When empty, any Google account can sign in.
ADMIN_EMAILS=

# Central website content
MONGODB_URI=mongodb://localhost:27017/educanvas
MONGODB_DATABASE=educanvas

# Google Drive service account used for public images and PDF documents
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=
